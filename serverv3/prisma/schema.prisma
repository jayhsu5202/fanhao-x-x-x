generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model DownloadJob {
  id             String   @id
  slug           String
  quality        String
  status         String
  message        String?
  outputPath     String?
  filename       String?
  fileSizeBytes  BigInt?
  ffmpegExitCode Int?
  ffmpegSummary  String?
  startedAt      DateTime?
  finishedAt     DateTime?
  verifiedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([slug, quality])
  @@index([status])
}

model Favorite {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String?
  createdAt DateTime @default(now())
}
