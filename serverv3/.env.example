# Prisma SQLite（相對於 server/ 目錄）；未設定時程式會 fallback 到專案 data/app.sqlite
DATABASE_URL="file:../data/app.sqlite"

PORT=3001
HOST=0.0.0.0
# Pino：info（預設）、warn、error、silent 等；終端想安靜可設 warn
# LOG_LEVEL=info
# HLS 分片請求預設不寫 access log（避免洗版）；除錯串流設 1
# STREAM_REQUEST_LOG=
# 每筆串流回應結束時印 bytes / ms / Mbps（仍建議關閉 STREAM_REQUEST_LOG 以免重複）
# STREAM_METRICS_LOG=1
STREAM_SECRET=change-me-to-a-long-random-string
# 純 Node 下載仍需系統 ffmpeg；未設時預設找 PATH 內的 ffmpeg
# FFMPEG_PATH=ffmpeg
DOWNLOAD_DIR=./data/downloads
# 繁中預設根網址；改 https://missav.ws/en 則標題為英文
MISSAV_BASE_URL=https://missav.ai
# 留空或設為 * / true 表示反射請求來源（本機最省事）；正式環境請設具體網域
CORS_ORIGIN=
# 留空時 m3u8 與分片網址使用相對路徑 /api/stream（搭配 Vite proxy 或同源反代）
PUBLIC_BASE_URL=
# 下載／縮圖／影片頁 HTML／上游連線併發：正整數即可任意加大；0、-1、unlimited、max → 程式內 65535（非真無限，防耗盡 FD）
# 同時下載路數；每個下載工作會占用一個 ffmpeg 子程序
# DOWNLOAD_QUEUE_CONCURRENCY=6
# 長駐 MissAV session 數（Node 內 cookie/session pool）
# MISSAV_SESSION_POOL_SIZE=4
# MISSAV_FETCH_TIMEOUT_MS=22000
# MISSAV_FETCH_RETRIES=4
# VIDEO_PAGE_FETCH_CONCURRENCY=28
#
# --- 串流播放斷續時可嘗試（不影響 API 契約；預設維持程式內建值）---
# 搭配上一行 STREAM_METRICS_LOG=1 可看每段 /api/stream 的 bytes、ms、約略 Mbps。
# - STREAM_SEGMENT_CACHE=0：關閉 Node 端 HLS 分片記憶體 LRU，減輕 GC／記憶體震盪；缺點是重播／快進時較常重打上游。
# - STREAM_UPSTREAM_HTTP2=0：改對上游走 HTTP/1.1（預設 1 為 HTTP/2 multiplex）；若 CDN 對 h2 有怪異背壓可試關閉。
# - UPSTREAM_CONNECTIONS_PER_ORIGIN：收斂對「同一 origin」併發（預設 192）；過高可能擠爆本機或上游，可試 96～128 實測。
# UPSTREAM_CONNECTIONS_PER_ORIGIN=192
# STREAM_UPSTREAM_HTTP2=1
# undici 對上游 keep-alive（毫秒）
# UPSTREAM_KEEPALIVE_TIMEOUT_MS=120000
# HLS 分片記憶體 LRU：邊播邊 tee 寫入；0 關閉
# STREAM_SEGMENT_CACHE=1
# STREAM_SEGMENT_CACHE_MAX_ENTRIES=384
# STREAM_SEGMENT_CACHE_MAX_TOTAL_BYTES=268435456
# STREAM_SEGMENT_CACHE_MAX_SEGMENT_BYTES=12582912
# THUMB_PARSE_CACHE_TTL_MS=900000
# THUMB_PARSE_CACHE_MAX_ENTRIES=2048
# 縮圖「圖檔位元組」記憶體快取（與上列解析 URL 分開）；0／false／off 關閉
# THUMB_IMAGE_CACHE=1
# THUMB_IMAGE_CACHE_TTL_MS=900000
# THUMB_IMAGE_CACHE_MAX_ENTRIES=1024
# 影片詳情 API 解析結果快取（毫秒／筆數上限），減少重複抓 MissAV 頁
# VIDEO_PAGE_PARSE_CACHE_TTL_MS=600000
# VIDEO_PAGE_PARSE_CACHE_MAX_ENTRIES=1024
# Recombee：逾時毫秒、429/5xx 重試次數、連線池大小、首頁單次筆數上限
# RECOMBEE_TIMEOUT_MS=25000
# RECOMBEE_RETRIES=3
# RECOMBEE_CONNECTIONS=24（下限 4；亦支援 unlimited / max）
# 未帶 ?limit= 時的預設筆數；RECOMBEE_FEED_MAX_BATCH / FEATURED_MAX_LIMIT 亦當作此值
# RECOMBEE_FEED_DEFAULT_BATCH=100
# 單次請求筆數硬上限（預設與程式內最大值一致；要收緊再改小）
# RECOMBEE_FEED_REQUEST_MAX=1000000
